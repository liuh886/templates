---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="{{APP_TITLE}}" />
    <title>{{APP_TITLE}}</title>
  </head>
  <body>
    <main class="min-h-screen px-5 py-12 sm:px-8 sm:py-20">
      <section class="mx-auto max-w-3xl">
        <p class="mb-4 text-sm font-bold">{{APP_TITLE}}</p>
        <h1 class="max-w-[14ch] text-5xl font-semibold leading-[0.98] tracking-[-0.05em] sm:text-7xl">
          Replace this with the real product promise.
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-8 text-neutral-600">
          This neutral page only proves the content/data starter builds. Replace it with the product's real information architecture and canonical data projection.
        </p>
      </section>
    </main>
  </body>
</html>
